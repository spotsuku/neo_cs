{
  "functions": {
    "api/claude.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/db.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/db-all.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/db/all",
      "destination": "/api/db-all"
    },
    {
      "source": "/api/db",
      "destination": "/api/db"
    }
  ]
}