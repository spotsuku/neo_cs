# =============================================================
# NEO CS v2 — 環境変数テンプレート
# このファイルをコピーして .env.local を作成し、各値を埋める。
# .env.local はリポジトリにコミットしない (.gitignore で除外済)。
#
# 変数の出所:
#   01: ストリーム01 (基盤) で導入
#   04: ストリーム04 (運用/セキュリティ) で導入
# =============================================================

# ── [01] Supabase ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用 (Route Handler / Server Action からのみ使用)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_PROJECT_REF=

# ── [01] Google OAuth (Supabase Auth Provider) ───────────────
# CLIENT_ID/SECRET は Supabase Dashboard → Authentication → Providers → Google
# にも同一値を登録する必要がある。本ファイルはアプリ起動時の参照用。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=neoacademia.jp

# ── [01] 初期管理者・リポジトリドライバ ────────────────────
INITIAL_ADMIN_EMAIL=
# mock | supabase
REPO_DRIVER=mock

# ── [04] Anthropic API ───────────────────────────────────────
# サーバー専用。/api/claude proxy のみで使用
ANTHROPIC_API_KEY=
# 上書き任意 (デフォルト claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6
# 1リクエストあたり生成トークン上限 (デフォルト 1024)
CLAUDE_MAX_TOKENS=1024
# purpose 別モデル指定 (未指定なら CLAUDE_MODEL_DEFAULT → CLAUDE_MODEL → デフォルト)
CLAUDE_MODEL_DEFAULT=
CLAUDE_MODEL_SURVEY_INSIGHT=claude-opus-4-7
CLAUDE_MODEL_WEEKLY_REVIEW=claude-opus-4-7
CLAUDE_MODEL_VOC_EXTRACTION=claude-opus-4-7
CLAUDE_MODEL_MAIL_ANALYSIS=claude-sonnet-4-6
CLAUDE_MODEL_MAIL_EXTRACTION=claude-sonnet-4-6
CLAUDE_MODEL_MAIL_REPLY=claude-sonnet-4-6
CLAUDE_MODEL_SURVEY_IMPORT=claude-sonnet-4-6
CLAUDE_MODEL_MAIL_SUMMARY=claude-haiku-4-5

# ── [04] CORS ────────────────────────────────────────────────
# カンマ区切り。本番は本番ドメインのみ。
# 例: https://cs.neoacademia.jp,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── [04] CSP モード ─────────────────────────────────────────
# true (デフォルト) で Content-Security-Policy ヘッダ enforce。
# false で Content-Security-Policy-Report-Only にフォールバック (緊急時のみ)。
CSP_ENFORCE=true

# ── [04] 観測性 (構造化ログ) ─────────────────────────────────
# debug | info | warn | error | fatal
LOG_LEVEL=info

# ── [04] Sentry ──────────────────────────────────────────────
# 未設定なら no-op フォールバック (stderr に構造化ログ)。
#
# DSN 発行手順:
#   1. https://sentry.io/ で組織にログイン (NEO ACADEMIA org)
#   2. Projects → Create Project → Platform: Next.js
#      Project name: neo-cs-v2 (本番) / neo-cs-v2-staging (ステージング)
#   3. 作成後の DSN (https://<key>@o<orgId>.ingest.sentry.io/<projectId>) をコピー
#   4. 本番は Vercel env、開発は .env.local に貼付
#   5. パッケージ追加: cd neo-cs-v2 && npm i @sentry/nextjs
#      (未インストールでも optional-import が no-op で動くが、本番では必ず入れる)
#   6. CSP_REPORT_URI 用の Security エンドポイントを Project → Settings →
#      Security Headers から取得 (CSP enforce 移行時に併設)
#
# サンプリング率: 開発 1.0 / staging 0.5 / 本番 0.1 を推奨
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── [04] CSP 違反レポート受信先 ──────────────────────────────
# 未設定時は report-uri ディレクティブを出力しない。
# Sentry CSP エンドポイント or 自前 collector の URL を設定。
CSP_REPORT_URI=

# ── [04] Slack 通知 (チャンネル別 incoming webhook) ──────────
# 未設定なら no-op + stderr ログにフォールバック
# CS_ALERTS: 可用性/エラー系アラート (ヘルスチェック失敗、レート制限多発)
# CS_INCIDENT: P0/P1 インシデント宣言・更新
# CHURN_ALERTS: 解約予兆 (severity high/critical) — F項
# EXPANSION: エクスパンション機会通知 — F項
# VOC: 顧客の声 (priority=high) — H項
#   発行手順: Slack Workspace → Apps → "Incoming Webhooks" → Add to Slack
#            → Channel = #cs-voc 推奨 → Webhook URL を貼付
# CS_OPPORTUNITY: 旧名互換 (将来 EXPANSION に統合予定)
SLACK_WEBHOOK_URL_CS_ALERTS=
SLACK_WEBHOOK_URL_CS_INCIDENT=
SLACK_WEBHOOK_URL_CHURN_ALERTS=
SLACK_WEBHOOK_URL_EXPANSION=
SLACK_WEBHOOK_URL_VOC=
SLACK_WEBHOOK_URL_CS_OPPORTUNITY=
# HANDOFF: 営業 (neo-sales) → CS 引継ぎ通知 (Phase4-#6)
SLACK_WEBHOOK_URL_HANDOFF=

# ── [Phase4-#6] 営業 → CS 引継ぎ webhook ────────────────────
# /api/integrations/sales/handoff の Bearer トークン (Authorization: Bearer ${SALES_HANDOFF_SECRET})
# 32+ 文字のランダム値推奨。漏洩したら即ローテ。
# neo-sales 側の NEO_CS_HANDOFF_SECRET と同値で設定すること。
SALES_HANDOFF_SECRET=

# ── [04] 通知重複防止 driver ─────────────────────────────────
# memory   : プロセス内 Map (TTL 24h)。単一インスタンス前提。開発デフォルト
# supabase : notification_dedup テーブルの主キー衝突で原子的判定。
#            水平スケール環境では必須。Vercel本番は supabase 推奨。
NOTIFICATION_DEDUP_DRIVER=memory

# ── [04] 縮退モード強制スイッチ ──────────────────────────────
# true | 1 で該当依存サービスを使わず縮退UIへ誘導
DEGRADED_ANTHROPIC=
DEGRADED_GMAIL=
DEGRADED_SUPABASE=

# ── Google Drive (テンプレート資料の顧客フォルダ複製 + F4 送付履歴) ──
# Service Account 作成手順:
#   1. GCP Console → IAM → Service Accounts → Create
#   2. Drive API を有効化、Service Account JSON Key を発行
#   3. テンプレート格納フォルダ + 顧客親フォルダを Shared Drive に置き、
#      Service Account に「コンテンツ管理者」権限を付与
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_DRIVE_TEMPLATE_FOLDER_ID=
GOOGLE_DRIVE_CUSTOMER_PARENT_FOLDER_ID=

# ── Client-visible Google Hosted Domain (login UI のヒント表示用) ──
# サーバ側 GOOGLE_HOSTED_DOMAIN と同値で OK
NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN=neoacademia.jp

# ── Gmail 送信機能トグル ───────────────────────────────────
# true | 1 で Gmail 送信 API を無効化 (返信フローのドラフトのみ)
NEO_CS_DISABLE_GMAIL_SEND=

# ── Rate Limit driver ────────────────────────────────────────
# memory   : プロセス内 Map (TTL 1h)、単一インスタンス前提
# supabase : rate_limit_counters テーブル (migration 0034) で水平スケール対応
RATE_LIMIT_DRIVER=memory

# ── [04] v1 凍結サーバ (server.js) の移行案内先 ──────────────
NEO_CS_V2_URL=https://cs.neoacademia.jp

# ── [04] アプリのベースURL (Slack通知の dashboardUrl 構築に使用) ──
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# ── [04] Vercel Cron / 手動キック の認証トークン ──────────────
# Vercel が cron 実行時に Authorization: Bearer <CRON_SECRET> を付与する
# 32+ 文字のランダム値を強く推奨。漏洩したら即ローテ。
CRON_SECRET=

# ── [Dev only] mock/開発用切替 ───────────────────────────────
# Server Action 内でアクター固定したい開発時のみ使用
CURRENT_USER_ID=
MOCK_CURRENT_USER_EMAIL=

# ── 標準 ──────────────────────────────────────────────────────
NODE_ENV=development
