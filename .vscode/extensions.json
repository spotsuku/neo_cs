{
  // 開発者にインストールを推奨する VS Code 拡張機能。
  // 初回 clone 後の VS Code 起動時に「推奨拡張機能をインストールしますか？」と聞かれる。
  "recommendations": [
    // Next.js / TypeScript
    "dbaeumer.vscode-eslint",
    "esbenp.prettier-vscode",
    "yoavbls.pretty-ts-errors",
    "mikestead.dotenv",
    "christian-kohler.path-intellisense",

    // Tailwind CSS
    "bradlc.vscode-tailwindcss",
    "heybourn.headwind",

    // Supabase / SQL (supabase/migrations 編集用)
    "supabase.vscode-supabase-extension",
    "mtxr.sqltools",
    "mtxr.sqltools-driver-pg",
    "qufiwefefwoyn.inline-sql-syntax",

    // Vitest 連携 (テスト UI)
    "vitest.explorer",

    // Git / PR レビュー
    "github.vscode-pull-request-github",
    "eamodio.gitlens",
    "clutchsecurity.clutch-gitleaks-secrets-scanner",

    // メール統合 / API debug (Gmail / Anthropic)
    "humao.rest-client",

    // コード品質
    "wix.vscode-import-cost",
    "streetsidesoftware.code-spell-checker",

    // Markdown / docs
    "yzhang.markdown-all-in-one"
  ]
